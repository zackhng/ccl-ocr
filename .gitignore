.coverage
htmlcov/
*.egg-info/

# Pixels are not committed: 249 MB, and the real sources carry redistribution
# restrictions. Nothing is lost -- the synthetic half regenerates exactly from its seed
# (`ocrbench.cli synth --seed 7`) and the real half re-downloads via scripts/fetch_*.py,
# both pinned by bench/manifest.json.
#
# The manifest and every benchmark result ARE committed: they are the record of what
# was measured. Run `scripts/ensure_data.py` to materialise the data itself.
bench/images/
bench/gt/
bench/raw/
bench/results/*/overlays/
overlays/

# Held-out tuning set (seed 11) for split thresholds: regenerated, never committed.
bench_tune/
